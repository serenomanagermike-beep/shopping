    function renderKPIs() {
      const totalItems = state.inventory.length;
      const categories = new Set(state.inventory.map(i => i.category)).size;
      
      let spoilRiskCount = 0;
      const urgentItems = [];

      state.inventory.forEach(item => {
        const days = calculateDaysRemaining(item.boughtDate, item.shelfLife);
        if (days <= 3) {
          spoilRiskCount++;
          urgentItems.push({ ...item, daysLeft: days });
        }
      });

      let totalSpent = 0;
      let totalIfAldi = 0;
      state.inventory.forEach(item => {
        const p = parseFloat(item.price) || 0;
        totalSpent += p;
        totalIfAldi += p * (STORE_PRICE_FACTORS['ALDI'] / (STORE_PRICE_FACTORS[item.store] || 1.0));
      });
      const potentialSavings = Math.max(0, totalSpent - totalIfAldi);

      document.getElementById('kpi-total-items').textContent = totalItems;
      document.getElementById('kpi-total-categories').textContent = `${categories} categories tracked`;
      document.getElementById('kpi-spoil-risk').textContent = spoilRiskCount;
      document.getElementById('kpi-potential-savings').textContent = `$${potentialSavings.toFixed(2)}`;
      document.getElementById('kpi-restock-needed').textContent = state.restockList.length;

      document.getElementById('badge-inventory-count').textContent = totalItems;
      document.getElementById('badge-restock-count').textContent = state.restockList.length;

      const spoilBox = document.getElementById('spoilage-alert-box');
      const urgentChips = document.getElementById('spoilage-urgent-chips');
      
      if (spoilRiskCount > 0) {
        spoilBox.classList.remove('hidden');
        urgentChips.innerHTML = urgentItems.map(item => `
          <span class="inline-flex items-center space-x-1 text-xs font-semibold px-2.5 py-1 rounded-md ${item.daysLeft <= 0 ? 'bg-red-200 text-red-900 border border-red-300' : 'bg-amber-200 text-amber-900 border border-amber-300'}">
            <span>${item.name}</span>
            <span class="font-bold">(${item.daysLeft <= 0 ? 'Expired' : item.daysLeft + 'd left'})</span>
          </span>
        `).join('');
      } else {
        spoilBox.classList.add('hidden');
      }
    }

    function renderInventory() {
      const search = document.getElementById('inventory-search')?.value.toLowerCase() || '';
      const filterFresh = document.getElementById('filter-freshness')?.value || 'all';
      const filterCat = document.getElementById('filter-category')?.value || 'all';

      const tbody = document.getElementById('inventory-table-body');
      const emptyState = document.getElementById('inventory-empty');
      if (!tbody) return;

      const filtered = state.inventory.filter(item => {
        const days = calculateDaysRemaining(item.boughtDate, item.shelfLife);
        const status = getFreshnessStatus(days);

        const matchSearch = item.name.toLowerCase().includes(search) || item.category.toLowerCase().includes(search);
        const matchCat = filterCat === 'all' || item.category === filterCat;
        const matchFresh = filterFresh === 'all' || status.code === filterFresh;

        return matchSearch && matchCat && matchFresh;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      filtered.sort((a, b) => {
        const da = calculateDaysRemaining(a.boughtDate, a.shelfLife);
        const db = calculateDaysRemaining(b.boughtDate, b.shelfLife);
        return da - db;
      });

      tbody.innerHTML = filtered.map(item => {
        const daysLeft = calculateDaysRemaining(item.boughtDate, item.shelfLife);
        const status = getFreshnessStatus(daysLeft);
        const pctRemaining = Math.max(0, Math.min(100, Math.round((daysLeft / item.shelfLife) * 100)));

        return `
          <tr class="hover:bg-slate-50 transition border-b border-slate-100">
            <td class="py-3 px-4">
              <div class="font-semibold text-slate-800">${item.name}</div>
              <div class="text-xs text-slate-400 flex items-center space-x-1 mt-0.5">
                <span>${getCategoryEmoji(item.category)}</span>
                <span>${item.category}</span>
              </div>
            </td>
            <td class="py-3 px-4">
              <div class="font-bold text-slate-800">$${parseFloat(item.price).toFixed(2)}</div>
              <span class="text-[11px] text-slate-400">${item.store || 'Publix'}</span>
            </td>
            <td class="py-3 px-4 text-xs text-slate-500 font-medium">
              ${item.boughtDate}
            </td>
            <td class="py-3 px-4 min-w-[180px]">
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="font-medium ${daysLeft <= 1 ? 'text-red-700 font-bold' : daysLeft <= 3 ? 'text-amber-700 font-bold' : 'text-slate-600'}">
                  ${daysLeft <= 0 ? 'Expired' : `${daysLeft} days remaining`}
                </span>
                <span class="text-[11px] text-slate-400">${item.shelfLife}d total life</span>
              </div>
              <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                <div class="h-full rounded-full transition-all duration-300 ${daysLeft <= 0 ? 'bg-red-600' : daysLeft <= 3 ? 'bg-amber-500' : 'bg-emerald-500'}" style="width: ${pctRemaining}%"></div>
              </div>
            </td>
            <td class="py-3 px-4 text-center">
              <span class="inline-block text-xs font-semibold px-2.5 py-1 rounded-full ${status.badgeClass}">
                ${status.label}
              </span>
            </td>
            <td class="py-3 px-4 text-right">
              <div class="flex items-center justify-end space-x-1.5">
                <button onclick="quickConsumeItem('${item.id}')" title="Mark as Eaten / Consumed" class="p-1.5 text-emerald-600 hover:bg-emerald-50 rounded-lg transition">
