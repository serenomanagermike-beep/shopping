        totalPaid += paid;
        
        const basePublixPrice = paid / (STORE_PRICE_FACTORS[item.store] || 1.0);

        const aldiPrice = basePublixPrice * STORE_PRICE_FACTORS['ALDI'];
        const walmartPrice = basePublixPrice * STORE_PRICE_FACTORS['Walmart'];
        const publixPrice = basePublixPrice * STORE_PRICE_FACTORS['Publix'];
        const tjPrice = basePublixPrice * STORE_PRICE_FACTORS['Trader Joe\'s'];
        const wdPrice = basePublixPrice * STORE_PRICE_FACTORS['Winn-Dixie'];

        storeTotals['ALDI'] += aldiPrice;
        storeTotals['Walmart'] += walmartPrice;
        storeTotals['Trader Joe\'s'] += tjPrice;
        storeTotals['Winn-Dixie'] += wdPrice;
        storeTotals['Publix'] += publixPrice;

        return {
          name: item.name,
          category: item.category,
          paid: paid,
          aldi: aldiPrice,
          walmart: walmartPrice,
          publix: publixPrice
        };
