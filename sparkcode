      const ctx = document.getElementById('storeComparisonChart');
      if (ctx) {
        if (storeChartInstance) storeChartInstance.destroy();
        storeChartInstance = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: ['ALDI', 'Walmart', 'Trader Joe\'s', 'Winn-Dixie', 'Publix (Benchmark)'],
            datasets: [{
              label: 'Total Grocery Basket Cost ($)',
              data: [
                storeTotals['ALDI'],
                storeTotals['Walmart'],
                storeTotals['Trader Joe\'s'],
                storeTotals['Winn-Dixie'],
                storeTotals['Publix']
              ],
              backgroundColor: ['#10b981', '#3b82f6', '#f59e0b', '#ef4444', '#64748b'],
