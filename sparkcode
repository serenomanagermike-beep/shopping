    function updateCheckinCount() {
      const checked = document.querySelectorAll('.checkin-checkbox:checked').length;
      document.getElementById('checkin-selected-count').textContent = `${checked} items selected`;
    }

    function submitWeeklyCheckin() {
      const checkboxes = document.querySelectorAll('.checkin-checkbox:checked');
      if (checkboxes.length === 0) {
        alert('Please select at least one item you finished or check off.');
        return;
      }

      checkboxes.forEach(cb => {
        const id = cb.getAttribute('data-id');
        const name = cb.getAttribute('data-name');
        const bought = cb.getAttribute('data-bought');
        const outcome = cb.closest('div').querySelector('.checkin-outcome').value;

        const idx = state.inventory.findIndex(i => i.id === id);
        if (idx !== -1) {
          const item = state.inventory[idx];
          if (outcome === 'consumed') {
            updateItemVelocity(name, bought);
            state.consumptionStats.consumedCount = (state.consumptionStats.consumedCount || 0) + 1;
            if (!state.restockList.some(r => r.name.toLowerCase() === name.toLowerCase())) {
              state.restockList.push({
                name: name,
                category: item.category,
                checked: false,
                autoAdded: true
              });
            }
          } else {
            state.consumptionStats.spoiledCount = (state.consumptionStats.spoiledCount || 0) + 1;
          }
          state.inventory.splice(idx, 1);
        }
      });

      saveState();
      closeModal('weeklyCheckinModal');
      alert(`Weekly check-in complete! Restock list and usage velocity updated.`);
    }

    let currentExtractedItems = [];

    function handleReceiptImageUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const spinner = document.getElementById('receipt-scanning-spinner');
      spinner.classList.remove('hidden');

      setTimeout(() => {
        spinner.classList.add('hidden');
        loadSampleReceipt('Publix');
      }, 1200);
    }

    function loadSampleReceipt(storeKey) {
      const data = SAMPLE_RECEIPTS[storeKey];
      if (!data) return;

      document.getElementById('modal-receipt-store').value = data.store;
      document.getElementById('modal-receipt-total').value = data.total.toFixed(2);
      document.getElementById('modal-receipt-date').value = new Date().toISOString().split('T')[0];

      currentExtractedItems = JSON.parse(JSON.stringify(data.items));
      renderModalExtractedTable();
    }

    function renderModalExtractedTable() {
      const tbody = document.getElementById('modal-extracted-items-body');
      if (!tbody) return;

      tbody.innerHTML = currentExtractedItems.map((item, idx) => `
        <tr class="border-b border-slate-100">
          <td class="py-1.5 px-3">
            <input type="text" value="${item.name}" onchange="currentExtractedItems[${idx}].name=this.value" class="w-full bg-transparent border-0 border-b border-slate-200 focus:border-emerald-500 text-xs font-semibold">
          </td>
          <td class="py-1.5 px-2">
            <select onchange="currentExtractedItems[${idx}].category=this.value" class="bg-transparent text-xs text-slate-600">
              <option value="Produce" ${item.category === 'Produce' ? 'selected' : ''}>Produce</option>
              <option value="Dairy & Eggs" ${item.category === 'Dairy & Eggs' ? 'selected' : ''}>Dairy & Eggs</option>
              <option value="Meat & Seafood" ${item.category === 'Meat & Seafood' ? 'selected' : ''}>Meat & Seafood</option>
              <option value="Bakery" ${item.category === 'Bakery' ? 'selected' : ''}>Bakery</option>
              <option value="Pantry" ${item.category === 'Pantry' ? 'selected' : ''}>Pantry</option>
              <option value="Frozen" ${item.category === 'Frozen' ? 'selected' : ''}>Frozen</option>
              <option value="Beverages" ${item.category === 'Beverages' ? 'selected' : ''}>Beverages</option>
            </select>
          </td>
          <td class="py-1.5 px-2">
            <input type="number" value="${item.qty || 1}" min="1" onchange="currentExtractedItems[${idx}].qty=parseInt(this.value)" class="w-10 text-xs bg-slate-50 border border-slate-200 rounded p-1 text-center">
          </td>
          <td class="py-1.5 px-2">
            <input type="number" step="0.01" value="${item.price}" onchange="currentExtractedItems[${idx}].price=parseFloat(this.value)" class="w-16 text-xs bg-slate-50 border border-slate-200 rounded p-1 font-bold">
          </td>
          <td class="py-1.5 px-2">
            <input type="number" value="${item.shelfLife || 7}" onchange="currentExtractedItems[${idx}].shelfLife=parseInt(this.value)" class="w-14 text-xs bg-slate-50 border border-slate-200 rounded p-1 text-center">
          </td>
          <td class="py-1.5 px-2 text-right">
            <button onclick="removeModalLineItem(${idx})" class="text-slate-400 hover:text-red-600">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
            </button>
          </td>
        </tr>
      `).join('');
      lucide.createIcons();
    }

    function addModalReceiptLineItem() {
      currentExtractedItems.push({
        name: 'New Grocery Item',
        category: 'Produce',
        qty: 1,
        price: 2.99,
        shelfLife: 7
      });
      renderModalExtractedTable();
    }

    function removeModalLineItem(idx) {
      currentExtractedItems.splice(idx, 1);
      renderModalExtractedTable();
    }

    function commitReceiptToInventory() {
      if (currentExtractedItems.length === 0) {
        alert('Please extract or add at least one line item.');
        return;
      }

      const store = document.getElementById('modal-receipt-store').value || 'Publix';
      const date = document.getElementById('modal-receipt-date').value || new Date().toISOString().split('T')[0];
      const total = parseFloat(document.getElementById('modal-receipt-total').value) || 0;

      const newItems = currentExtractedItems.map((item, idx) => ({
        id: `item-${Date.now()}-${idx}`,
        name: item.name,
        category: item.category,
        qty: item.qty || 1,
        price: item.price,
        store: store,
        boughtDate: date,
        shelfLife: item.shelfLife || DEFAULT_SHELF_LIVES[item.name] || 7
      }));

      state.inventory.push(...newItems);

      state.receipts.unshift({
        id: `rec-${Date.now()}`,
        store: store,
        date: date,
        total: total || newItems.reduce((acc, i) => acc + (parseFloat(i.price)||0), 0),
        itemCount: newItems.length,
        items: newItems
      });

      saveState();
      closeModal('receiptModal');
      alert(`Successfully added ${newItems.length} items to your inventory! Freshness and savings calculated.`);
    }

    function commitManualItem() {
      const name = document.getElementById('manual-item-name').value.trim();
      const category = document.getElementById('manual-item-category').value;
      const shelfLife = parseInt(document.getElementById('manual-item-shelflife').value) || 7;
      const price = parseFloat(document.getElementById('manual-item-price').value) || 0;
      const store = document.getElementById('manual-item-store').value;

      if (!name) {
        alert('Please enter an item name');
        return;
      }

      const today = new Date().toISOString().split('T')[0];
      state.inventory.push({
        id: `item-${Date.now()}`,
        name: name,
        category: category,
        qty: 1,
        price: price,
        store: store,
        boughtDate: today,
        shelfLife: shelfLife
      });

      saveState();
      closeModal('addItemModal');
      document.getElementById('manual-item-name').value = '';
    }

    function openModal(id) {
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.classList.remove('hidden');

      if (id === 'receiptModal' && currentExtractedItems.length === 0) {
        loadSampleReceipt('Publix');
      }
      if (id === 'weeklyCheckinModal') {
        populateWeeklyCheckinModal();
      }
      lucide.createIcons();
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) modal.classList.add('hidden');
    }

    window.addEventListener('DOMContentLoaded', () => {
      loadState();
      renderAll();
      document.getElementById('modal-receipt-date').value = new Date().toISOString().split('T')[0];
    });
  </script>
</body>
</html>
