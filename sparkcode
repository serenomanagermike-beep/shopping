          { name: 'Friendly Farms Whole Milk', category: 'Dairy & Eggs', qty: 1, price: 2.78, shelfLife: 7 },
          { name: 'Fresh Chicken Tenderloins', category: 'Meat & Seafood', qty: 1, price: 6.89, shelfLife: 3 },
          { name: 'Organic Baby Spinach (8oz)', category: 'Produce', qty: 1, price: 2.49, shelfLife: 5 },
          { name: 'Goldhen Grade A Large Eggs', category: 'Dairy & Eggs', qty: 1, price: 2.95, shelfLife: 21 },
          { name: 'Fresh California Strawberries', category: 'Produce', qty: 1, price: 2.99, shelfLife: 4 },
          { name: 'L\'oven Fresh Artisanal Bread', category: 'Bakery', qty: 1, price: 2.89, shelfLife: 6 },
          { name: 'Specially Selected Greek Yogurt', category: 'Dairy & Eggs', qty: 1, price: 4.19, shelfLife: 14 },
          { name: 'Avocados 6pk', category: 'Produce', qty: 1, price: 3.77, shelfLife: 5 }
        ]
      }
    };

    let state = {
      inventory: [],
      receipts: [],
      restockList: [],
      velocity: {},
      consumptionStats: { consumedCount: 0, spoiledCount: 0 }
    };

    function loadState() {
      const saved = localStorage.getItem('smartpantry_data_v1');
      if (saved) {
        try {
          state = JSON.parse(saved);
        } catch (e) {
          console.error('Failed to parse local storage', e);
        }
      }

      if (!state.inventory || state.inventory.length === 0) {
        seedInitialFloridaData();
      }
    }

    function saveState() {
      localStorage.setItem('smartpantry_data_v1', JSON.stringify(state));
      renderAll();
    }

    function seedInitialFloridaData() {
      const today = new Date();
      const formatIso = (d) => d.toISOString().split('T')[0];

      const twoDaysAgo = new Date();
      twoDaysAgo.setDate(today.getDate() - 2);

      const items = [
        { id: 'item-1', name: 'Fresh Strawberries (16oz)', category: 'Produce', qty: 1, price: 4.99, store: 'Publix', boughtDate: formatIso(twoDaysAgo), shelfLife: 4 },
        { id: 'item-2', name: 'Organic Baby Spinach', category: 'Produce', qty: 1, price: 4.29, store: 'Publix', boughtDate: formatIso(twoDaysAgo), shelfLife: 5 },
        { id: 'item-3', name: 'Publix Whole Milk (Gallon)', category: 'Dairy & Eggs', qty: 1, price: 4.19, store: 'Publix', boughtDate: formatIso(twoDaysAgo), shelfLife: 7 },
        { id: 'item-4', name: 'Boneless Chicken Breast (2 lb)', category: 'Meat & Seafood', qty: 1, price: 10.98, store: 'Publix', boughtDate: formatIso(twoDaysAgo), shelfLife: 3 },
        { id: 'item-5', name: 'Large White Eggs (Dozen)', category: 'Dairy & Eggs', qty: 1, price: 3.89, store: 'Publix', boughtDate: formatIso(twoDaysAgo), shelfLife: 21 },
        { id: 'item-6', name: 'Bakery Sourdough Bread', category: 'Bakery', qty: 1, price: 4.49, store: 'Publix', boughtDate: formatIso(twoDaysAgo), shelfLife: 6 },
        { id: 'item-7', name: 'Greek Yogurt (32oz)', category: 'Dairy & Eggs', qty: 1, price: 5.49, store: 'Publix', boughtDate: formatIso(twoDaysAgo), shelfLife: 14 }
      ];

      state.inventory = items;
      state.receipts = [{
        id: 'rec-1',
        store: 'Publix - Madeira Beach',
        date: formatIso(twoDaysAgo),
        total: 38.32,
        itemCount: items.length,
        items: items
      }];

      state.velocity = {
        'Whole Milk': { avgDays: 6, count: 3 },
        'Organic Baby Spinach': { avgDays: 4, count: 2 },
        'Eggs': { avgDays: 12, count: 4 },
        'Chicken Breast': { avgDays: 3, count: 3 },
        'Sourdough Bread': { avgDays: 5, count: 2 }
      };

      state.consumptionStats = { consumedCount: 18, spoiledCount: 2 };
      state.restockList = [];
    }

    function calculateDaysRemaining(boughtDateStr, shelfLifeDays) {
      const bought = new Date(boughtDateStr);
      const expiry = new Date(bought);
      expiry.setDate(bought.getDate() + parseInt(shelfLifeDays));
      
      const now = new Date();
      now.setHours(0,0,0,0);
      expiry.setHours(0,0,0,0);

      const diffTime = expiry.getTime() - now.getTime();
      return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    }

    function getFreshnessStatus(daysRemaining) {
      if (daysRemaining <= 0) return { label: 'Expired / Critical', code: 'critical', badgeClass: 'badge-critical', icon: 'alert-circle' };
      if (daysRemaining <= 3) return { label: `${daysRemaining}d left (Use Soon)`, code: 'warning', badgeClass: 'badge-warning', icon: 'clock' };
      return { label: `${daysRemaining}d left (Fresh)`, code: 'fresh', badgeClass: 'badge-fresh', icon: 'check-circle' };
    }

    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('active', 'border-emerald-600', 'text-emerald-700');
        btn.classList.add('border-transparent', 'text-slate-500');
      });

