<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartPantry Pro - Receipt Scanner, Freshness & Price Optimizer</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#ecfdf5',
              100: '#d1fae5',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              800: '#065f46',
            }
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    .badge-critical { background-color: #fee2e2; color: #991b1b; border: 1px solid #f87171; }
    .badge-warning { background-color: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }
    .badge-fresh { background-color: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- TOP HEADER -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white shadow-md">
            <i data-lucide="shopping-bag" class="w-6 h-6"></i>
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <span class="text-xl font-bold text-slate-900 tracking-tight">SmartPantry</span>
              <span class="text-xs uppercase font-extrabold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full tracking-wider">Pro</span>
            </div>
            <p class="text-xs text-slate-500 hidden sm:block">Receipt Scanning, Spoilage Alerts & Price Optimization</p>
          </div>
        </div>

        <!-- Quick Action Buttons -->
        <div class="flex items-center space-x-2">
          <button onclick="openModal('receiptModal')" class="flex items-center space-x-1.5 bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-lg text-sm font-medium transition shadow-sm">
            <i data-lucide="scan" class="w-4 h-4"></i>
            <span>Scan Receipt</span>
          </button>
          <button onclick="openModal('weeklyCheckinModal')" class="flex items-center space-x-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 px-3.5 py-2 rounded-lg text-sm font-medium transition">
            <i data-lucide="check-square" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Weekly Check-in</span>
          </button>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="flex space-x-1 sm:space-x-8 overflow-x-auto py-2 border-t border-slate-100 no-scrollbar">
        <button onclick="switchTab('inventory')" id="tab-btn-inventory" class="tab-btn active flex items-center space-x-2 py-2 px-3 text-sm font-medium border-b-2 border-emerald-600 text-emerald-700 whitespace-nowrap">
          <i data-lucide="refrigerator" class="w-4 h-4"></i>
          <span>Inventory & Spoilage</span>
          <span id="badge-inventory-count" class="bg-emerald-100 text-emerald-800 text-xs px-2 py-0.5 rounded-full font-semibold">0</span>
        </button>
        <button onclick="switchTab('priceComp')" id="tab-btn-priceComp" class="tab-btn flex items-center space-x-2 py-2 px-3 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700 whitespace-nowrap">
          <i data-lucide="trending-down" class="w-4 h-4"></i>
          <span>Price Comparison & Savings</span>
        </button>
        <button onclick="switchTab('restockList')" id="tab-btn-restockList" class="tab-btn flex items-center space-x-2 py-2 px-3 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700 whitespace-nowrap">
          <i data-lucide="list-checks" class="w-4 h-4"></i>
          <span>Smart Restock List</span>
          <span id="badge-restock-count" class="bg-amber-100 text-amber-800 text-xs px-2 py-0.5 rounded-full font-semibold">0</span>
        </button>
        <button onclick="switchTab('receiptArchive')" id="tab-btn-receiptArchive" class="tab-btn flex items-center space-x-2 py-2 px-3 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700 whitespace-nowrap">
          <i data-lucide="receipt" class="w-4 h-4"></i>
          <span>Receipt History</span>
        </button>
        <button onclick="switchTab('velocityAnalytics')" id="tab-btn-velocityAnalytics" class="tab-btn flex items-center space-x-2 py-2 px-3 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700 whitespace-nowrap">
          <i data-lucide="gauge" class="w-4 h-4"></i>
          <span>Usage Velocity</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- KPI STATS SUMMARY CARDS -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Active Inventory</p>
          <p id="kpi-total-items" class="text-2xl font-bold text-slate-900 mt-1">0</p>
          <p id="kpi-total-categories" class="text-xs text-slate-400 mt-0.5">0 categories tracked</p>
        </div>
        <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl">
          <i data-lucide="package" class="w-6 h-6"></i>
        </div>
      </div>

      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Spoil Risk (&lt;3 Days)</p>
          <p id="kpi-spoil-risk" class="text-2xl font-bold text-amber-600 mt-1">0</p>
          <p class="text-xs text-slate-400 mt-0.5">Eat soon to prevent waste</p>
        </div>
        <div class="p-3 bg-amber-50 text-amber-600 rounded-xl">
          <i data-lucide="alert-triangle" class="w-6 h-6"></i>
        </div>
      </div>

      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Potential Savings</p>
          <p id="kpi-potential-savings" class="text-2xl font-bold text-emerald-600 mt-1">$0.00</p>
          <p class="text-xs text-slate-400 mt-0.5">By store optimization</p>
        </div>
        <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl">
          <i data-lucide="badge-dollar-sign" class="w-6 h-6"></i>
        </div>
      </div>

      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Restock Needed</p>
          <p id="kpi-restock-needed" class="text-2xl font-bold text-blue-600 mt-1">0</p>
          <p class="text-xs text-slate-400 mt-0.5">Paced on consumption</p>
        </div>
        <div class="p-3 bg-blue-50 text-blue-600 rounded-xl">
          <i data-lucide="shopping-cart" class="w-6 h-6"></i>
        </div>
      </div>
    </div>

    <!-- TAB 1: INVENTORY & SPOILAGE -->
    <section id="tab-inventory" class="tab-content active space-y-6">
      
      <!-- Critical Spoilage Alerts Banner -->
      <div id="spoilage-alert-box" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 shadow-sm">
        <div class="flex items-start justify-between">
          <div class="flex items-start space-x-3">
            <div class="p-2 bg-red-100 text-red-700 rounded-lg mt-0.5">
              <i data-lucide="flame" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="text-sm font-bold text-red-900">Action Needed: Food Items Spoilage Warning</h3>
              <p id="spoilage-alert-text" class="text-xs text-red-700 mt-1">These items are expiring soon. Consider consuming or freezing them today.</p>
              <div id="spoilage-urgent-chips" class="flex flex-wrap gap-2 mt-2.5">
                <!-- dynamic chips inserted here -->
              </div>
            </div>
          </div>
          <button onclick="openModal('weeklyCheckinModal')" class="text-xs font-semibold bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded-lg transition whitespace-nowrap">
            Mark As Consumed
          </button>
        </div>
      </div>

      <!-- Controls & Filters Bar -->
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2 flex-1">
          <div class="relative flex-1 min-w-[200px] max-w-md">
            <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
            <input type="text" id="inventory-search" oninput="renderInventory()" placeholder="Search items (e.g., Milk, Salmon, Berries)..." class="w-full pl-9 pr-3 py-1.5 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500">
          </div>
          
          <select id="filter-freshness" onchange="renderInventory()" class="text-xs py-1.5 px-2.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500">
            <option value="all">All Freshness Status</option>
            <option value="critical">🔴 Critical / Expired (≤ 0d)</option>
            <option value="warning">🟡 Use Soon (1 - 3d)</option>
            <option value="fresh">🟢 Fresh (&gt; 3d)</option>
          </select>

          <select id="filter-category" onchange="renderInventory()" class="text-xs py-1.5 px-2.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500">
            <option value="all">All Categories</option>
            <option value="Produce">🥬 Produce</option>
            <option value="Dairy & Eggs">🥛 Dairy & Eggs</option>
            <option value="Meat & Seafood">🥩 Meat & Seafood</option>
            <option value="Bakery">🍞 Bakery</option>
            <option value="Pantry">🥫 Pantry</option>
            <option value="Frozen">❄️ Frozen</option>
            <option value="Beverages">🧃 Beverages</option>
          </select>
        </div>

        <div class="flex items-center space-x-2">
          <button onclick="openModal('addItemModal')" class="flex items-center space-x-1.5 bg-slate-800 hover:bg-slate-900 text-white text-xs font-medium px-3.5 py-2 rounded-lg transition">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Add Item Manually</span>
          </button>
        </div>
      </div>

      <!-- Inventory Table -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-xs font-semibold uppercase text-slate-500 border-b border-slate-200">
              <tr>
                <th class="py-3.5 px-4">Item & Category</th>
                <th class="py-3.5 px-4">Store & Price Paid</th>
                <th class="py-3.5 px-4">Bought Date</th>
                <th class="py-3.5 px-4">Freshness & Spoilage Countdown</th>
                <th class="py-3.5 px-4 text-center">Status</th>
                <th class="py-3.5 px-4 text-right">Quick Action</th>
              </tr>
            </thead>
            <tbody id="inventory-table-body" class="divide-y divide-slate-100">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
        
        <div id="inventory-empty" class="hidden py-16 text-center">
          <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-3">
            <i data-lucide="inbox" class="w-8 h-8"></i>
          </div>
          <h4 class="text-base font-semibold text-slate-800">No Inventory Items Found</h4>
          <p class="text-sm text-slate-500 max-w-sm mx-auto mt-1">Scan a receipt or add items to track freshness, consumption velocity, and savings.</p>
          <button onclick="openModal('receiptModal')" class="mt-4 inline-flex items-center space-x-2 bg-emerald-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-emerald-700 transition">
            <i data-lucide="camera" class="w-4 h-4"></i>
            <span>Scan First Receipt</span>
          </button>
        </div>
      </div>
    </section>

    <!-- TAB 2: PRICE COMPARISON & SAVINGS ENGINE -->
    <section id="tab-priceComp" class="tab-content space-y-6">
      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-5">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Grocery Price Comparison & Savings Engine</h2>
            <p class="text-sm text-slate-500 mt-0.5">Benchmark your recent grocery bills against competitor stores in Madeira Beach / St. Pete area.</p>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-xs font-semibold text-slate-500">Benchmark Store:</span>
            <select id="benchmark-store-select" onchange="renderPriceComparison()" class="text-xs py-1.5 px-3 bg-slate-50 border border-slate-200 rounded-lg font-medium text-slate-700 focus:ring-2 focus:ring-emerald-500">
              <option value="ALDI">ALDI (Deep Discount)</option>
              <option value="Walmart">Walmart (Everyday Low Price)</option>
              <option value="Trader Joe's">Trader Joe's</option>
              <option value="Winn-Dixie">Winn-Dixie</option>
              <option value="Publix">Publix</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-6">
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
            <p class="text-xs font-semibold uppercase text-slate-500">Total Spent (Recorded)</p>
            <p id="price-total-paid" class="text-2xl font-bold text-slate-900 mt-1">$0.00</p>
            <p class="text-xs text-slate-400 mt-0.5">Across all uploaded receipts</p>
          </div>
          <div class="p-4 bg-emerald-50 rounded-xl border border-emerald-200">
            <p class="text-xs font-semibold uppercase text-emerald-700">Cost at Cheapest Store (ALDI)</p>
            <p id="price-cheapest-cost" class="text-2xl font-bold text-emerald-800 mt-1">$0.00</p>
            <p id="price-cheapest-pct" class="text-xs text-emerald-600 mt-0.5">Save up to 24% overall</p>
          </div>
          <div class="p-4 bg-teal-50 rounded-xl border border-teal-200">
            <p class="text-xs font-semibold uppercase text-teal-700">Net Wallet Savings</p>
            <p id="price-net-savings" class="text-2xl font-bold text-teal-800 mt-1">+$0.00</p>
            <p class="text-xs text-teal-600 mt-0.5">Money you could keep in your pocket</p>
          </div>
        </div>

        <!-- Store Comparison Chart -->
        <div class="mt-8">
          <h3 class="text-sm font-bold text-slate-900 mb-3">Cost Comparison of Your Grocery Baskets by Retailer</h3>
          <div class="h-64 relative">
            <canvas id="storeComparisonChart"></canvas>
          </div>
        </div>

        <!-- Item Differential Table -->
        <div class="mt-8">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold text-slate-900">Item Price Differentials Across Stores</h3>
            <span class="text-xs text-slate-400">Based on local Florida store averages</span>
          </div>
          <div class="overflow-x-auto border border-slate-200 rounded-xl">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 text-xs font-semibold uppercase text-slate-500 border-b border-slate-200">
                <tr>
                  <th class="py-3 px-4">Item Name</th>
                  <th class="py-3 px-4">Category</th>
                  <th class="py-3 px-4">You Paid</th>
                  <th class="py-3 px-4">ALDI</th>
                  <th class="py-3 px-4">Walmart</th>
                  <th class="py-3 px-4">Publix</th>
                  <th class="py-3 px-4">Best Store</th>
                </tr>
              </thead>
              <tbody id="price-comparison-table-body" class="divide-y divide-slate-100">
                <!-- dynamic rows -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- TAB 3: SMART RESTOCK LIST -->
    <section id="tab-restockList" class="tab-content space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <div class="lg:col-span-2 bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <div>
              <h2 class="text-lg font-bold text-slate-900">Smart Shopping List</h2>
              <p class="text-xs text-slate-500 mt-0.5">Auto-populated based on consumption speed & depleted inventory.</p>
            </div>
            <div class="flex items-center space-x-2">
              <button onclick="autoGenerateRestockList()" class="flex items-center space-x-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 text-xs font-semibold px-3 py-1.5 rounded-lg transition">
                <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                <span>Auto-Generate</span>
              </button>
              <button onclick="clearCheckedRestock()" class="text-xs text-slate-500 hover:text-slate-800 px-2 py-1.5">
                Clear Checked
              </button>
            </div>
          </div>

          <div class="flex items-center space-x-2">
            <input type="text" id="manual-restock-input" placeholder="Add custom item (e.g. Olive Oil, Garlic, Coffee)..." class="flex-1 text-sm bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
            <select id="manual-restock-category" class="text-xs bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-2 text-slate-700">
              <option value="Produce">Produce</option>
              <option value="Dairy & Eggs">Dairy & Eggs</option>
              <option value="Meat & Seafood">Meat & Seafood</option>
              <option value="Bakery">Bakery</option>
              <option value="Pantry">Pantry</option>
              <option value="Frozen">Frozen</option>
              <option value="Beverages">Beverages</option>
            </select>
            <button onclick="addManualRestockItem()" class="bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold px-4 py-2 rounded-lg transition">
              Add
            </button>
          </div>

          <div id="restock-items-container" class="divide-y divide-slate-100 min-h-[220px]">
            <!-- dynamic items rendered here -->
          </div>

          <div id="restock-empty-state" class="hidden text-center py-12">
            <i data-lucide="check-circle" class="w-10 h-10 text-emerald-500 mx-auto mb-2"></i>
            <p class="text-sm font-semibold text-slate-800">All stocked up! No items on your list.</p>
            <p class="text-xs text-slate-500 mt-0.5">Click "Auto-Generate" to calculate items needed based on your usage speed.</p>
          </div>
        </div>

        <div class="space-y-4">
          <div class="bg-gradient-to-br from-emerald-700 to-teal-800 text-white p-5 rounded-xl shadow-md">
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase font-bold tracking-wider text-emerald-200">Optimal Shopping Trip</span>
              <span class="bg-emerald-500/30 text-white text-xs font-semibold px-2 py-0.5 rounded-full">Recommended Store</span>
            </div>
            <h3 id="restock-best-store" class="text-2xl font-black mt-2">ALDI</h3>
            <p class="text-xs text-emerald-100 mt-1">Lowest total projected cost for your current list.</p>
            
            <div class="mt-4 pt-4 border-t border-emerald-600/50 flex items-center justify-between">
              <div>
                <p class="text-xs text-emerald-200">Estimated Basket</p>
                <p id="restock-best-price" class="text-xl font-bold mt-0.5">$0.00</p>
              </div>
              <div class="text-right">
                <p class="text-xs text-emerald-200">Estimated Savings</p>
                <p id="restock-savings-vs-publix" class="text-sm font-semibold text-emerald-200 mt-0.5">Saves ~$14.20 vs. Publix</p>
              </div>
            </div>
          </div>

          <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <h4 class="text-xs font-bold uppercase text-slate-500 tracking-wider mb-3">Estimated Basket by Retailer</h4>
            <div class="space-y-2.5 text-sm" id="restock-store-breakdown">
              <!-- dynamic store totals -->
            </div>
          </div>

          <div class="flex space-x-2">
            <button onclick="copyRestockList()" class="flex-1 flex items-center justify-center space-x-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold py-2.5 rounded-lg transition">
              <i data-lucide="copy" class="w-4 h-4"></i>
              <span>Copy Text List</span>
            </button>
            <button onclick="window.print()" class="flex items-center justify-center space-x-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-4 py-2.5 rounded-lg transition">
              <i data-lucide="printer" class="w-4 h-4"></i>
              <span>Print</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- TAB 4: RECEIPT ARCHIVE -->
    <section id="tab-receiptArchive" class="tab-content space-y-6">
      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-4">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Scanned Receipt Archive</h2>
            <p class="text-xs text-slate-500 mt-0.5">Historical records of uploaded receipts, store totals, and pricing breakdowns.</p>
          </div>
          <button onclick="openModal('receiptModal')" class="flex items-center space-x-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-3.5 py-2 rounded-lg transition">
            <i data-lucide="upload" class="w-4 h-4"></i>
