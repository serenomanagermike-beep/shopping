    function quickConsumeItem(itemId) {
      const idx = state.inventory.findIndex(i => i.id === itemId);
      if (idx === -1) return;

      const item = state.inventory[idx];
      updateItemVelocity(item.name, item.boughtDate);
      state.consumptionStats.consumedCount = (state.consumptionStats.consumedCount || 0) + 1;
      
      if (!state.restockList.some(r => r.name.toLowerCase() === item.name.toLowerCase())) {
        state.restockList.push({
          name: item.name,
          category: item.category,
          checked: false,
          autoAdded: true
        });
      }

      state.inventory.splice(idx, 1);
      saveState();
    }

    function quickDiscardItem(itemId) {
      const idx = state.inventory.findIndex(i => i.id === itemId);
      if (idx === -1) return;

      state.consumptionStats.spoiledCount = (state.consumptionStats.spoiledCount || 0) + 1;
      state.inventory.splice(idx, 1);
      saveState();
    }

    function updateItemVelocity(name, boughtDateStr) {
      const bought = new Date(boughtDateStr);
      const now = new Date();
      const daysTaken = Math.max(1, Math.ceil((now - bought) / (1000 * 60 * 60 * 24)));

      if (!state.velocity[name]) {
        state.velocity[name] = { avgDays: daysTaken, count: 1 };
      } else {
        const cur = state.velocity[name];
        const newCount = cur.count + 1;
        const newAvg = Math.round(((cur.avgDays * cur.count) + daysTaken) / newCount);
        state.velocity[name] = { avgDays: newAvg, count: newCount };
      }
    }

