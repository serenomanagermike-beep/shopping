      if (!input || !input.value.trim()) return;

      state.restockList.push({
        name: input.value.trim(),
        category: cat,
        checked: false,
        autoAdded: false
      });

      input.value = '';
      saveState();
    }

    function autoGenerateRestockList() {
      const toRestock = new Set(state.restockList.map(i => i.name.toLowerCase()));
      let added = 0;

      Object.keys(state.velocity).forEach(itemName => {
        if (!toRestock.has(itemName.toLowerCase())) {
          const inPantry = state.inventory.some(i => i.name.toLowerCase().includes(itemName.toLowerCase()));
          if (!inPantry) {
            state.restockList.push({
              name: itemName,
              category: 'Pantry',
              checked: false,
              autoAdded: true
            });
            added++;
          }
        }
      });

      saveState();
      alert(added > 0 ? `Auto-generated ${added} items based on your usage velocity!` : 'All regular staples are currently well-stocked in your pantry.');
    }

